// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum SendStatus {
  scheduled
  sent
  failed
  skipped
}

enum ReplyClassification {
  interested
  not_interested
  out_of_office
  unsubscribe
  neutral
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  goal        String         // what the campaign is trying to achieve
  tone        String         // e.g. "formal", "friendly", "direct"
  status      CampaignStatus @default(draft)
  baseSubject String?
  baseBody    String?        // the Composer agent's output — template with {{placeholders}}
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  contacts    Contact[]
  emailSteps  EmailStep[]
}

model Contact {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  email         String
  firstName     String?
  lastName      String?
  company       String?
  metadata      String?   // JSON blob for arbitrary personalization fields

  unsubscribed  Boolean   @default(false)
  createdAt     DateTime  @default(now())

  emailSteps    EmailStep[]

  @@unique([campaignId, email])
}

model EmailStep {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  stepNumber    Int         // 1 = initial send, 2+ = follow-ups
  subject       String
  body          String      // personalized final draft, ready to send
  sendAt        DateTime
  status        SendStatus  @default(scheduled)

  gmailThreadId String?     // set after first send, used to track replies + thread follow-ups
  gmailMessageId String?

  sentAt        DateTime?
  errorMessage  String?

  createdAt     DateTime    @default(now())

  sendLogs      SendLog[]
  replies       Reply[]
}

model SendLog {
  id          String      @id @default(cuid())
  emailStepId String
  emailStep   EmailStep   @relation(fields: [emailStepId], references: [id], onDelete: Cascade)

  status      SendStatus
  message     String?     // success confirmation or error detail
  createdAt   DateTime    @default(now())
}

model Reply {
  id                String                @id @default(cuid())
  emailStepId       String
  emailStep         EmailStep             @relation(fields: [emailStepId], references: [id], onDelete: Cascade)

  fromEmail         String
  snippet           String
  classification     ReplyClassification?
  receivedAt        DateTime
  createdAt         DateTime              @default(now())
}

model GmailAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
